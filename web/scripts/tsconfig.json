{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "ESNext",
    "moduleResolution": "bundler", "moduleDetection": "force", "types": ["node"],
    "strict": true, "noUncheckedIndexedAccess": true,
    "allowJs": true, "checkJs": true,
    "declaration": false, "noEmit": true, "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true, "skipLibCheck": true,
    "isolatedModules": true, "resolveJsonModule": true
  },
  "include": ["check-lint-config.mjs"]
}
